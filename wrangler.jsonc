{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "livsolv",
  "compatibility_date": "2026-10-29",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/binder/*"
    ]
  },
  "main": "worker/delivery.mjs",
  "r2_buckets": [
    {
      "binding": "PAID_PRODUCTS",
      "bucket_name": "livsolv-paid-products"
    }
  ],
  "vars": {
    "DELIVERY_ENABLED": "false",
    "BINDER_PAYMENT_LINK": "plink_1UHPAJF8NR7INldShG4eXtn4",
    "BINDER_OBJECT_KEY": "releases/household-binder-v8.zip"
  }
}
