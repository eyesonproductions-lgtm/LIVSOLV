{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "livsolv",
  "compatibility_date": "2026-10-29",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
